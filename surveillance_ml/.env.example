# ============================================================
# Variables d'environnement — LBP Surveillance ML
# Copier ce fichier en .env et remplir les valeurs réelles
# NE JAMAIS committer le fichier .env dans Git
# ============================================================

# --- Connexion Base de données MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=lbp_db
DB_USERNAME=admin
DB_PASSWORD=

# --- Configuration ML ---
ML_CONTAMINATION_AUTO=true        # true = auto-calibration depuis labels DG
ML_CONTAMINATION_FIXED=0.08       # Utilisé si ML_CONTAMINATION_AUTO=false
ML_SUPERVISED_MIN_LABELS=50       # Seuil d'activation Random Forest
ML_SUPERVISED_MIN_POSITIVES=10
ML_SUPERVISED_MIN_NEGATIVES=10
ML_DRIFT_MIN_WEEKS=6
ML_WEIGHTS_ANOMALY=0.40
ML_WEIGHTS_DRIFT=0.30
ML_WEIGHTS_SUPERVISED=0.30
ML_PSEUDO_LABELS_ENABLED=true     # Pseudo-labels depuis alertes PHP (cold start)
ML_MODEL_VERSIONS_TO_KEEP=3       # Nombre de versions à conserver

# --- Scheduler ---
ML_SCHEDULE_HOUR=23               # Heure d'exécution du cron (23h00 par défaut)
ML_SCHEDULE_ENABLED=true

# --- API ---
ML_API_PORT=8001
ML_API_HOST=0.0.0.0
